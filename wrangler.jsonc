{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sfsafi-blog",
  // AI_API_KEY is a dashboard Secret. AI_BASE_URL, AI_MODEL and
  // AI_DAILY_LIMIT are dashboard variables; preserve them across Git builds.
  "keep_vars": true,
  "main": "worker/index.ts",
  "vars": { "OWNER_EMAIL": "jonce_z@126.com" },
  "triggers": { "crons": ["*/5 * * * *"] },
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Content pages must pass published-only D1 checks, including HTML aliases.
    // Immutable public scripts/fonts/media stay asset-first.
    "run_worker_first": [
      "/*",
      "!/_astro/*",
      "!/media/*",
      "!/licenses/*",
      "!/favicon.svg",
    ],
    "not_found_handling": "404-page",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sfsafi-engagement",
      "database_id": "8713524f-f776-4dbc-8a9f-1b03414c6cf6",
      "migrations_dir": "migrations",
    },
  ],
}
