# Cloudflare Worker runtime variables (non-secret; configure in the dashboard).
# ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
# ACCESS_AUD=your-admin-application-audience
# D1 binding DB is configured in wrangler.jsonc, never use the placeholder ID in production.

# AI_API_KEY: configure as a Worker Secret, never a public/client variable.
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=your-provider-model-id
# AI_DAILY_LIMIT=100

# OWNER_EMAIL=your-owner-email@example.com (mandatory for writing/moderation)
# SITE_URL=https://sfsafi-blog.jonce-z.workers.dev
# QQ_BOT_WEBHOOK_URL=https://your-deployed-bot.workers.dev/site-updates
# QQ_SITE_SECRET: dashboard Secret, same independent random value on both Workers.
# Bot-only: QQ_APP_ID (Text), QQ_APP_SECRET (Secret), QQ_GROUP_IDS, QQ_GROUP_OPERATOR_IDS.
