---
import { formatDate, type Post } from '../lib/content';
import MediaGrid from './MediaGrid.astro';
import Engagement from './Engagement.astro';
import SharePost from './SharePost.astro';
import ReadingTools from './ReadingTools.astro';
import { markdownDocument } from '../lib/markdown';
import { contentText } from '../lib/text';
const { post, detail = false } = Astro.props as {
  post: Post;
  detail?: boolean;
};
const preview = detail
  ? ''
  : post.excerpt || contentText({ ...post, body: post.body.slice(0, 1200) });
const body = detail
  ? post.body
  : preview.slice(0, 280) + (preview.length > 280 ? '…' : '');
const document =
  detail && post.bodyFormat === 'markdown' ? markdownDocument(body) : undefined;
---

<article
  class:list={[
    'post-card',
    { pinned: post.pinned, 'detail-card': detail, 'feed-card': !detail },
  ]}
  data-reading={detail && post.kind === 'article' ? '' : undefined}
  data-location-post={post.id}
>
  {post.pinned && (
    <div class="pin-label">
      <span aria-hidden="true">⌁</span> 置顶 · 从这里开始
    </div>
  )}
  <div class="post-meta">
    <img
      src="/media/avatar.svg"
      width="36"
      height="36"
      alt=""
      data-profile-avatar
    />
    <div>
      <strong data-profile-name>SFSafi</strong>
      <span>
        <time datetime={post.firstPublishedAt}>
          {formatDate(post.firstPublishedAt!)}
        </time>{' '}
        · {post.kind === 'article' ? '文章' : '动态'}
      </span>
    </div>
    <a
      class="post-permalink"
      href={post.canonicalPath}
      aria-label="打开这条内容的稳定链接"
    >
      ↗
    </a>
  </div>
  {post.title && (
    <h2 class="post-title">
      <a href={post.canonicalPath}>{post.title}</a>
    </h2>
  )}
  {detail && post.kind === 'article' && (
    <ReadingTools body={post.body} headings={document?.headings} />
  )}
  {document ? (
    <div class="post-body" set:html={document.html} />
  ) : (
    <div class="post-body">
      {body.split('\n\n').map((paragraph) => (
        <p>{paragraph}</p>
      ))}
    </div>
  )}
  <MediaGrid media={post.media} />
  <a
    class="post-location"
    data-location-link
    href={`/locations/?place=${encodeURIComponent(post.location?.label || '')}`}
    hidden={!post.location}
  >
    <span aria-hidden="true">⌖</span> {post.location?.label}
  </a>
  <div class="post-bottom">
    <div class="tags">
      {post.tags.map((tag) => (
        <a href={`/tags/${encodeURIComponent(tag)}/`}># {tag}</a>
      ))}
    </div>
    {!detail && (
      <a class="read-more" href={post.canonicalPath}>
        {post.kind === 'article' ? '阅读全文' : '查看动态'}{' '}
        <span aria-hidden="true">→</span>
      </a>
    )}
  </div>
  {detail && post.updatedAt !== post.firstPublishedAt && (
    <p class="muted">更新于 {formatDate(post.updatedAt)}</p>
  )}
  <div class="post-tools">
    <Engagement postId={post.id} detail={detail} />
    <SharePost post={post} />
  </div>
</article>

<script>
  import '../lib/locations-client';
</script>
