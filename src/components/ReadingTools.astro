---
import type { ArticleHeading } from '../lib/markdown';
import { readingStats } from '../lib/text';
const { body, headings = [] } = Astro.props as {
  body: string;
  headings?: ArticleHeading[];
};
const stats = readingStats(body);
---

<div class="reading-meta">
  约 {stats.minutes} 分钟 · {stats.characters.toLocaleString('zh-CN')} 字
</div>
{headings.length > 1 && (
  <details class="article-toc" open>
    <summary>本文目录</summary>
    <ol data-user-content>
      {headings.map((h) => (
        <li style={`--heading-depth:${Math.min(h.depth - 1, 3)}`}>
          <a href={`#${h.id}`}>{h.text}</a>
        </li>
      ))}
    </ol>
  </details>
)}
<progress
  class="reading-progress"
  data-reading-progress
  max="100"
  value="0"
  aria-label="阅读进度"
  hidden
></progress>
<button class="reading-top" type="button" data-reading-top hidden>
  ↑ 回到开头
</button>
