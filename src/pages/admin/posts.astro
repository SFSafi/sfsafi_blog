---
import Admin from '../../layouts/Admin.astro';
---

<Admin title="文章与动态">
  <section class="page-heading">
    <h1>
      管理<span>你的内容。</span>
    </h1>
    <p>已发布文章可随时修改；删除后进入回收站，不再公开。</p>
    <a href="/admin/write/">写一篇新内容 →</a>
  </section>
  <section class="editor-panel">
    <form id="posts-filter" class="admin-toolbar">
      <input
        id="posts-query"
        type="search"
        maxlength="120"
        placeholder="搜索标题或正文"
        aria-label="搜索内容"
      />
      <select id="posts-filter-status" aria-label="内容状态">
        <option value="all">全部内容</option>
        <option value="published">已发布</option>
        <option value="draft">草稿</option>
        <option value="archived">归档</option>
        <option value="trash">回收站</option>
      </select>
      <button type="submit">搜索</button>
    </form>
    <p id="posts-status" role="status">
      正在验证站主身份…
    </p>
    <div id="posts-list"></div>
    <button id="posts-more" hidden>
      下一页
    </button>
  </section>
  <script>
    import '../../lib/posts-client';
  </script>
</Admin>
