---
import Base from '../../layouts/Base.astro';
---

<Base title="文章管理">
  <section class="page-heading">
    <h1>
      管理<span>记录。</span>
    </h1>
    <p>草稿与发布内容仅站主可管理。</p>
    <a href="/admin/write/">写一篇新内容 →</a> ·{' '}
    <a href="/admin/comments/">评论管理</a> ·{' '}
    <a href="/admin/notifications/">更新推送状态</a>·{' '}
    <a href="/admin/media/">视频转码</a>
  </section>
  <section class="editor-panel">
    <p id="posts-status" role="status">
      正在验证站主身份…
    </p>
    <ul id="posts-list"></ul>
    <button id="posts-more" hidden>
      下一页
    </button>
  </section>
  <script>
    let page = 1;
    const list = document.querySelector('#posts-list')!,
      status = document.querySelector('#posts-status')!,
      more = document.querySelector<HTMLButtonElement>('#posts-more')!;
    async function load() {
      more.disabled = true;
      try {
        const response = await fetch('/api/admin/posts?page=' + page, {
          signal: AbortSignal.timeout(10000),
        });
        const data = await response.json();
        if (!response.ok) throw Error(data.error);
        for (const post of data.items) {
          const item = document.createElement('li'),
            link = document.createElement('a'),
            meta = document.createElement('p');
          link.href = '/admin/write/?id=' + encodeURIComponent(post.id);
          link.textContent = post.title || '未命名';
          meta.textContent =
            (post.status === 'published'
              ? '已发布'
              : post.status === 'archived'
                ? '已归档'
                : '草稿') +
            ' · 版本 ' +
            post.revision;
          item.append(link, meta);
          list.append(item);
        }
        more.hidden = !data.hasMore;
        status.textContent = '已载入内容。';
      } catch (error) {
        status.textContent =
          error instanceof Error ? error.message : '读取失败。';
      } finally {
        more.disabled = false;
      }
    }
    more.addEventListener('click', () => {
      page++;
      void load();
    });
    void load();
  </script>
</Base>
