{
  "name": "sfsafi-personal-space",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev --host 0.0.0.0",
    "build": "npm run prepare && ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview --host 0.0.0.0",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "dev:worker": "WRANGLER_SEND_METRICS=false XDG_CONFIG_HOME=/tmp/sfsafi-config wrangler dev --config wrangler.local.jsonc --port 8787 --persist-to .wrangler/stable-state",
    "db:local": "WRANGLER_SEND_METRICS=false XDG_CONFIG_HOME=/tmp/sfsafi-config wrangler d1 migrations apply sfsafi-engagement --local --config wrangler.local.jsonc --persist-to .wrangler/stable-state",
    "build:worker": "npm run build && WRANGLER_SEND_METRICS=false XDG_CONFIG_HOME=/tmp/sfsafi-config wrangler deploy --dry-run --config wrangler.local.jsonc --outdir /tmp/sfsafi-worker-bundle",
    "prepare": "node scripts/prepare-schema.mjs",
    "build:bot": "WRANGLER_SEND_METRICS=false XDG_CONFIG_HOME=/tmp/sfsafi-config wrangler deploy --dry-run --config wrangler.bot.jsonc --outdir /tmp/sfsafi-bot-bundle"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "astro": "7.3.8",
    "image-size": "2.0.4",
    "jose": "6.2.12",
    "marked": "18.1.1",
    "misans": "5.0.0",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@cloudflare/workers-types": "4.20260702.1",
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.5",
    "@types/qrcode": "1.5.6",
    "miniflare": "4.20260730.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "typescript": "6.0.3",
    "wrangler": "4.100.0"
  }
}
